# Copy this file to .env and fill in your own values.
# cp .env.example .env

# Choose "openai", "huggingface", or "grok" — this is the only line you
# need to change to swap the entire LLM backend.
LLM_PROVIDER=openai

# --- Needed only if LLM_PROVIDER=openai ---
# Get a key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Needed only if LLM_PROVIDER=huggingface (also used for embeddings when LLM_PROVIDER=grok) ---
# Get a free token from https://huggingface.co/settings/tokens
HUGGINGFACEHUB_API_TOKEN=hf_...
HF_CHAT_MODEL=mistralai/Mistral-7B-Instruct-v0.3
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Needed only if LLM_PROVIDER=grok ---
# Get a key from https://console.x.ai (new accounts get promotional credit)
# Note: Grok has no embeddings API, so embeddings still use the
# Hugging Face settings above even when LLM_PROVIDER=grok.
XAI_API_KEY=xai-...
GROK_CHAT_MODEL=grok-4.3

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Retrieval ---
TOP_K=4

# --- Storage ---
VECTOR_STORE_DIR=vector_store
